  <property name="styleSheet">
   <string notr="true">QWidget#SettingsMainPage { background-color: #25292d; }
QWidget { color: #f1f3f5; font-size: 10pt; }
QLabel#settingsHeaderLabel { font-size: 17pt; font-weight: bold; }
QLabel#settingsStatusLabel { font-weight: bold; }
QListWidget#settingsNavList { background-color: #30363c; border: 1px solid #505a63; }
QListWidget#settingsNavList::item { padding: 7px 12px; }
QListWidget#settingsNavList::item:selected { background-color: #426b91; }
QPushButton { background-color: #30363c; border: 1px solid #505a63; border-radius: 4px; min-height: 28px; padding: 2px 12px; }
QPushButton#saveCameraSettingsButton, QPushButton#saveFineAdjustmentButton, QPushButton#saveWidgetAdjustmentButton,
QPushButton:hover:enabled { background-color: #426b91; }
QPushButton:focus { border-color: #aab3bc; }
QPushButton:disabled { color: #aab3bc; }
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit { background-color: #1f2327; min-height: 28px; }
QGroupBox { background-color: #30363c; border: 1px solid #505a63; margin-top: 10px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
QLabel#camera0PreviewLabel, QLabel#camera1PreviewLabel, QLabel#finePreviewLabel, QLabel#widgetFullPreviewLabel, QLabel#widgetCropPreviewLabel {
    background-color: #1f2327; border: 1px solid #505a63; color: #aab3bc; }
QTabWidget::pane, QScrollArea { background-color: #30363c; }
QTabBar::tab { background-color: #30363c; padding: 7px 14px; }
QTabBar::tab:selected { background-color: #426b91; }
QTableWidget, QPlainTextEdit { background-color: #1f2327; alternate-background-color: #30363c; }
QHeaderView::section { background-color: #30363c; color: #f1f3f5; padding: 4px; }
</string>
